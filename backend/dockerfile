FROM dunglas/frankenphp:latest-php8.2

# Set working directory
WORKDIR /app

# Install dependensi sistem dan ekstensi PHP untuk MySQL
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    && docker-php-ext-install pdo_mysql mbstring exify pcntl bcmath gd

# Copy composer dari official image
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Copy seluruh kode aplikasi backend
COPY . /app

# Install dependensi Laravel via Composer
RUN composer install --no-interaction --optimize-autoloader --no-dev

# Set hak akses folder storage dan cache Laravel
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache

# Expose port HTTP FrankenPHP (8080 internal)
EXPOSE 8080

# Jalankan FrankenPHP menunjuk ke folder public Laravel
CMD ["frankenphp", "php-server", "--listen", ":8080", "--root", "public/"]